global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend kubernetes_api
    bind {{ load_balancer_vip }}:6443
    default_backend control_plane

backend control_plane
    balance roundrobin
{% for node in groups['kube_control_plane'] %}
    server {{ node }} {{ hostvars[node].ip }}:6443 check inter 3s fall 3 rise 2
{% endfor %}

frontend application_http
    bind {{ load_balancer_vip }}:80
    default_backend ingress_http

frontend application_https
    bind {{ load_balancer_vip }}:443
    default_backend ingress_https

backend ingress_http
    balance roundrobin
{% for node in groups['kube_node'] %}
    server {{ node }} {{ hostvars[node].ip }}:30080 send-proxy-v2 check inter 3s fall 3 rise 2
{% endfor %}

backend ingress_https
    balance roundrobin
{% for node in groups['kube_node'] %}
    server {{ node }} {{ hostvars[node].ip }}:30443 send-proxy-v2 check inter 3s fall 3 rise 2
{% endfor %}

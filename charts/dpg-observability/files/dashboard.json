{
  "uid": "dpg-application",
  "title": "Digipay application",
  "tags": [
    "dpg"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Application requests",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "4xx and 5xx responses",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{exported_service=\"dpg-app-app-nginx-http@kubernetes\",code=~\"4..\"}[5m])) or (sum(rate(traefik_service_requests_total{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])) * 0)",
          "legendFormat": "4xx/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(traefik_service_requests_total{exported_service=\"dpg-app-app-nginx-http@kubernetes\",code=~\"5..\"}[5m])) or (sum(rate(traefik_service_requests_total{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])) * 0)",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Upstream latency p50 / p95 / p99",
      "description": "Traefik service time through NGINX and PHP. Not pure PHP execution time or end-to-end client latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(traefik_service_request_duration_seconds_bucket{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(traefik_service_request_duration_seconds_bucket{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(traefik_service_request_duration_seconds_bucket{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mean upstream response time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_request_duration_seconds_sum{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m])) / sum(rate(traefik_service_request_duration_seconds_count{exported_service=\"dpg-app-app-nginx-http@kubernetes\"}[5m]))",
          "legendFormat": "upstream mean"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "NGINX connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} active"
        },
        {
          "refId": "B",
          "expr": "nginx_connections_reading{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} reading"
        },
        {
          "refId": "C",
          "expr": "nginx_connections_writing{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} writing"
        },
        {
          "refId": "D",
          "expr": "nginx_connections_waiting{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} waiting"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PHP-FPM busy and idle workers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_active_processes{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} active"
        },
        {
          "refId": "B",
          "expr": "phpfpm_idle_processes{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} idle"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PHP-FPM saturation and queue",
      "description": "Pool ceiling is four per PHP pod; update this query and alert when changing pm.max_children.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "phpfpm_active_processes{namespace=\"dpg-app\"} / 4",
          "legendFormat": "{{pod}} fraction of max_children=4"
        },
        {
          "refId": "B",
          "expr": "phpfpm_listen_queue{namespace=\"dpg-app\"}",
          "legendFormat": "{{pod}} queued"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Container restarts (15m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"dpg-app\"}[15m])",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container CPU",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod,container)(rate(container_cpu_usage_seconds_total{namespace=\"dpg-app\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container memory working set",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod,container)(container_memory_working_set_bytes{namespace=\"dpg-app\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}} / {{container}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HPA replicas",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"dpg-app\"}",
          "legendFormat": "{{horizontalpodautoscaler}} current"
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"dpg-app\"}",
          "legendFormat": "{{horizontalpodautoscaler}} desired"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HPA replica changes (15m)",
      "description": "Observed changes in sampled replica count, not a Kubernetes Events archive; short-lived changes can be missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"dpg-app\"}[15m])",
          "legendFormat": "{{horizontalpodautoscaler}} changes"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "24h observed SLI",
      "description": "Availability target 99.9%; latency target 99% within 300 ms. No traffic gives no data; the window is partial after startup or data loss.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - dpg:slo_bad_ratio:24h",
          "legendFormat": "{{slo}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "24h error budget remaining",
      "description": "Negative means budget exceeded; allowed bad requests = total requests \u00d7 (1 - target).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dpg:slo_budget_remaining:ratio",
          "legendFormat": "{{slo}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
